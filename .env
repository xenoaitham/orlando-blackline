# WordPress Headless CMS Configuration
# Change this URL to your WordPress instance
VITE_WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
VITE_WORDPRESS_URL=http://localhost:8080

# Set to 'true' to enable WordPress content fetching
# Set to 'false' to use hardcoded fallback content only
VITE_WORDPRESS_ENABLED=true
